{
  "name": "sollycoin-dapp",
  "version": "1.0.0",
  "description": "SollyCoin dApp - Een modulaire JavaScript 3D-universum game met blockchain integratie",
  "main": "index.html",
  "scripts": {
    "start": "python3 -m http.server 5501",
    "dev": "python3 -m http.server 5501",
    "build": "hardhat compile",
    "test": "hardhat test",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "deploy:mumbai": "hardhat run scripts/deploy.js --network polygon_mumbai",
    "node": "hardhat node",
    "clean": "hardhat clean",
    "verify:sepolia": "hardhat verify --network sepolia",
    "verify:mumbai": "hardhat verify --network polygon_mumbai"
  },
  "keywords": [
    "blockchain",
    "dapp",
    "game",
    "ethereum",
    "solidity",
    "web3",
    "sollycoin"
  ],
  "author": "SollyCoin Team",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@openzeppelin/contracts": "^5.3.0",
    "dotenv": "^16.3.1",
    "hardhat": "^2.19.0"
  },
  "dependencies": {
    "ethers": "^6.8.0",
    "web3": "^4.2.0"
  }
}
